# AegiSpace Backend — Environment Variables
# Copy this file to .env and fill in your credentials.
# On Render, set these via Dashboard → Environment.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── FastRouter LLM ───────────────────────────────────────────────────────────
FASTROUTER_API_KEY=your-fastrouter-api-key
FASTROUTER_BASE_URL=https://api.fastrouter.io/v1
FASTROUTER_MODEL=gpt-4o

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AegiSpace
DEBUG=false
PORT=8080

# ── CORS (JSON array of allowed frontend origins) ────────────────────────────
# For production on Vercel, set to your actual domain:
ALLOWED_ORIGINS=["http://localhost:3000","https://aegispace.vercel.app"]
