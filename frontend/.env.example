# AegiSpace Frontend — Environment Variables
# Copy to .env.local for local development.
# On Vercel, set these in Dashboard → Settings → Environment Variables.

# The backend API base URL (no trailing slash)
# Local: http://localhost:8080
# Production: https://aegispace-api.onrender.com (your Render URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
